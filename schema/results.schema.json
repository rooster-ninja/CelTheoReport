{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rooster-ninja/CelTheoReport/schema/results.schema.json",
  "title": "CelTheo occultation results",
  "description": "Output of `python -m celtheo run`. Angles in degrees unless the key ends in _arcmin or _arcsec. Any number may be null when it could not be computed; check flags.warnings.",
  "type": "object",
  "required": ["schema_version", "generated_utc", "settings", "conventions", "events"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "generator": {"type": "string"},
    "generated_utc": {"type": "string", "format": "date-time"},
    "source_csv": {"type": "string"},
    "runtime_s": {"type": "number"},
    "settings": {
      "type": "object",
      "description": "Ray-trace settings (wavelength_nm, co2_ppm, segment_m, top_of_atmosphere_m, use_wgs84_ellipsoid, max_total_path_m)."
    },
    "conventions": {"type": "object", "additionalProperties": {"type": "string"}},
    "events": {"type": "array", "items": {"$ref": "#/$defs/event"}}
  },
  "$defs": {
    "num": {"type": ["number", "null"]},
    "site": {
      "type": "object",
      "properties": {"name": {"type": "string"}, "lat": {"$ref": "#/$defs/num"}, "lon": {"$ref": "#/$defs/num"}, "alt_m": {"$ref": "#/$defs/num"}}
    },
    "event": {
      "type": "object",
      "required": ["id", "row", "flags", "peak", "observer", "star"],
      "properties": {
        "id": {"type": "string", "description": "Stable slug: peak-star-UTCdate[-test-kind][-n]. Use as anchor/URL hash."},
        "row": {"type": "integer", "description": "Spreadsheet row in the source CSV (header = row 1)."},
        "flags": {
          "type": "object",
          "properties": {
            "target_type": {"enum": ["peak", "aircraft"]},
            "is_test": {"type": "boolean"},
            "test_kind": {"enum": [null, "epsilon", "aries"], "description": "Rows prefixed ϵ / ♈︎ in the CSV."},
            "warnings": {"type": "array", "items": {"type": "string"}, "description": "Human-readable data-quality notes. Show them."}
          }
        },
        "peak": {"$ref": "#/$defs/site", "description": "Occluding target (mountain peak, or aircraft position)."},
        "observer": {"$ref": "#/$defs/site"},
        "time": {
          "type": "object",
          "properties": {
            "local_date": {"type": "string"}, "local_time": {"type": "string"},
            "utc_offset_h": {"$ref": "#/$defs/num"}, "utc": {"type": ["string", "null"], "format": "date-time"}
          }
        },
        "star": {
          "type": "object",
          "description": "name = as written in the CSV; query = catalogue identifier; kind = star | body | unresolved.",
          "properties": {
            "name": {"type": "string"}, "query": {"type": ["string", "null"]}, "kind": {"enum": ["star", "body", "unresolved"]},
            "ra_deg": {"$ref": "#/$defs/num"}, "dec_deg": {"$ref": "#/$defs/num"},
            "pmra_masyr": {"$ref": "#/$defs/num"}, "pmdec_masyr": {"$ref": "#/$defs/num"}, "source": {"type": "string"}
          }
        },
        "csv": {
          "type": "object",
          "description": "Values as measured/entered in the spreadsheet. true_* = ♈︎ (geometric), app_* = ϵ (apparent); *_peak seen from the peak, *_obs from the observer.",
          "properties": {
            "true_peak": {"$ref": "#/$defs/num"}, "app_peak": {"$ref": "#/$defs/num"}, "true_obs": {"$ref": "#/$defs/num"}, "app_obs": {"$ref": "#/$defs/num"},
            "distance": {"$ref": "#/$defs/num"}, "drop_rate": {"$ref": "#/$defs/num"}, "temp_c": {"$ref": "#/$defs/num"}, "azi_peak": {"$ref": "#/$defs/num"},
            "gp_lat": {"$ref": "#/$defs/num"}, "gp_lon": {"$ref": "#/$defs/num", "description": "West-positive."}, "gp_dist": {"$ref": "#/$defs/num"},
            "ge_check": {"type": ["string", "null"]}, "canva": {"type": ["string", "null"]}, "star_name": {"type": "string"}
          }
        },
        "astropy": {
          "type": "object",
          "description": "Star position from catalogue coordinates (proper motion applied) at the UTC occlusion time. Empty when the star could not be resolved.",
          "properties": {
            "true_alt_obs_deg": {"$ref": "#/$defs/num", "description": "Geometric altitude from the observer (no refraction)."},
            "az_obs_deg": {"$ref": "#/$defs/num"},
            "true_alt_peak_deg": {"$ref": "#/$defs/num", "description": "Geometric altitude from the peak/target location."},
            "alt_rate_deg_per_s": {"$ref": "#/$defs/num", "description": "d(altitude)/dt at the observer; negative = setting."},
            "erfa_apparent_alt_obs_deg": {"$ref": "#/$defs/num", "description": "astropy/ERFA refracted altitude (simple model, for comparison)."},
            "temp_c_used": {"$ref": "#/$defs/num"}
          }
        },
        "refraction": {
          "type": "object",
          "description": "Ciddor ray trace through the radiosonde (or standard) atmosphere on the WGS-84 ellipsoid.",
          "properties": {
            "sounding": {
              "type": ["object", "null"],
              "properties": {
                "station": {"type": "string"}, "wmo": {"type": "string"}, "valid_utc": {"type": "string"},
                "source": {"enum": ["radiosonde", "standard-atmosphere fallback"]}, "distance_km": {"$ref": "#/$defs/num"},
                "levels": {"type": "integer"}, "ceiling_m": {"$ref": "#/$defs/num"}
              }
            },
            "peak_apparent_deg": {"$ref": "#/$defs/num", "description": "Elevation at which the refracted ray reaches the peak top."},
            "peak_geometric_deg": {"$ref": "#/$defs/num", "description": "Straight-line (globe) elevation of the peak top."},
            "peak_uplift_arcmin": {"$ref": "#/$defs/num"},
            "star_geometric_deg": {"$ref": "#/$defs/num", "description": "Globe+Ciddor prediction: true altitude of a star that appears exactly at the peak top. Normal-section radius."},
            "star_geometric_gauss_deg": {"$ref": "#/$defs/num", "description": "Same, Gauss radius (original refraction.py behaviour)."},
            "star_uplift_arcmin": {"$ref": "#/$defs/num"}, "star_uplift_gauss_arcmin": {"$ref": "#/$defs/num"},
            "bennett_arcmin": {"$ref": "#/$defs/num", "description": "Bennett (1982) at the peak's apparent elevation with observer P/T."},
            "pressure_hpa_obs": {"$ref": "#/$defs/num"}, "temp_c_obs": {"$ref": "#/$defs/num"}
          }
        },
        "geometry": {
          "type": "object",
          "properties": {
            "csv_distance_m": {"$ref": "#/$defs/num"}, "geodesic_distance_m": {"$ref": "#/$defs/num"}, "slant_range_m": {"$ref": "#/$defs/num"},
            "central_angle_deg": {"$ref": "#/$defs/num"}, "azimuth_deg": {"$ref": "#/$defs/num"}, "earth_radius_m": {"$ref": "#/$defs/num"},
            "planar_angle_deg": {"$ref": "#/$defs/num", "description": "Flat-earth rise over run: atan(Δh / CSV distance)."},
            "peak_height_above_observer_m": {"$ref": "#/$defs/num"}
          }
        },
        "comparison": {
          "type": "object",
          "description": "Observed-minus-model. Positive arcsec = the star was truly higher than the model's occlusion angle. *_seconds = clock offset that would close the gap.",
          "properties": {
            "globe_ciddor_arcsec": {"$ref": "#/$defs/num", "description": "astropy true alt − star_geometric_deg."},
            "globe_ciddor_seconds": {"$ref": "#/$defs/num"},
            "planar_geometric_arcsec": {"$ref": "#/$defs/num", "description": "astropy true alt − planar angle (no refraction)."},
            "planar_geometric_seconds": {"$ref": "#/$defs/num"},
            "planar_refracted_arcsec": {"$ref": "#/$defs/num", "description": "astropy ERFA apparent alt − planar angle."},
            "planar_refracted_seconds": {"$ref": "#/$defs/num"},
            "csv_true_obs_minus_astropy_arcsec": {"$ref": "#/$defs/num"},
            "csv_true_peak_minus_astropy_arcsec": {"$ref": "#/$defs/num"},
            "ciddor_minus_bennett_arcmin": {"$ref": "#/$defs/num"}
          }
        },
        "profiles": {
          "type": "object",
          "description": "For figures. Omitted with --no-profiles.",
          "properties": {
            "ray_to_peak": {"type": "array", "items": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}]},
                            "description": "[x_m, y_m] along the refracted ray from the observer: x = r·sin φ, y = r·cos φ − R (observer-local frame, Earth curving away below)."},
            "atmosphere": {"type": "array", "items": {"type": "object", "properties": {
              "alt_m": {"type": "number"}, "n_minus_1_ppm": {"$ref": "#/$defs/num"}, "T_K": {"$ref": "#/$defs/num"},
              "P_Pa": {"$ref": "#/$defs/num"}, "RH_pct": {"$ref": "#/$defs/num"}}},
              "description": "Every 500 m from the observer to 40 km."}
          }
        }
      }
    }
  }
}
